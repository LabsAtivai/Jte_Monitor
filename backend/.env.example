# Banco
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jte
DB_PASS=TROQUE_AQUI
DB_NAME=jte

# JWT — gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_SEGURO_AQUI
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@gmail.com
SMTP_PASS=APP_PASSWORD_AQUI
MAIL_FROM=JTe Monitor <seu@gmail.com>

# App
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://seudominio.com.br

# Redis (worker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Worker
CONCURRENCY=4
MESES=6
# TRT=TRT2 - São Paulo
# REGIAO=São Paulo - Zonas Central, Norte e Oeste
# VARAS=2
# DATA_INICIO=21/10/2026
# DATA_FIM=22/10/2026

# Modo nacional do mesmo worker (arquivos locais, sem MySQL/Redis)
# NATIONAL_DATE=22/10/2026
# NATIONAL_TRT=TRT1 - Rio de Janeiro
# NATIONAL_REGION=Rio de Janeiro
# NATIONAL_BUSINESS_DAYS=1
# NATIONAL_MAX_TRIBUNALS=1
# NATIONAL_MAX_REGIONS=1
# NATIONAL_MAX_UNITS=1
# NATIONAL_CONCURRENCY=2
# NATIONAL_START_RETRIES=2
# NATIONAL_RETRY_MINUTES=30
# NATIONAL_OUTPUT_DIR=/opt/jte-monitor/national-output
# NATIONAL_DAILY_TIME=06:00
# NATIONAL_CHROME_PATH=/usr/bin/google-chrome
# NATIONAL_HEADLESS=0

# Snov.io (enriquecimento de contatos, busca ao vivo por domínio)
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Gemini (análise de risco de contrato)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NanoNets (OCR documento -> texto)
NANONETS_API_TOKEN=
