[Unit]
Description=JTe national daily file scraper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jte
WorkingDirectory=/opt/jte-monitor/backend
EnvironmentFile=-/opt/jte-monitor/backend/national.env
ExecStart=/usr/bin/node worker/index.js --national-daily
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
